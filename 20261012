import tkinter as tk
from PIL import Image, ImageTk
import cv2
import serial
import pynmea2
import threading
import time
import os
import glob
import shutil
import subprocess

# ==================== 設定値 ====================
FPS = 15.0                  # 前後共通のフレームレート
REC_INTERVAL_SEC = 180      # 録画分割時間：3分（180秒）
MIN_FREE_GB = 2.0           # 空き容量が2GBを切ったら自動削除

# リアカメラ(USB)の解像度
REAR_REC_WIDTH = 640
REAR_REC_HEIGHT = 360

# UIプレビュー表示サイズ（800x600画面に合わせて大きく拡大）
PREVIEW_WIDTH = 760
PREVIEW_HEIGHT = 428
# ================================================

is_running = True
is_recording = True

latest_rear_frame = None
frame_lock = threading.Lock()

# GPSデータ保持用
latest_gps_info = {"speed": "--.- km/h", "lat": "N/A", "lon": "N/A", "time": "N/A"}
gps_lock = threading.Lock()

# --- タッチキャリブレーション適用関数 ---
def apply_touch_calibration():
    try:
        cmd = 'DISPLAY=:0 xinput set-prop "ADS7846 Touchscreen" "libinput Calibration Matrix" 0 1 0 -1 0 1 0 0 1'
        subprocess.run(cmd, shell=True, check=True, timeout=3)
        print("タッチキャリブレーションを適用しました")
    except Exception as e:
        print(f"キャリブレーション適用スキップ/エラー: {e}")

# --- ループ録画（自動容量管理）スレッド ---
def auto_cleanup_thread():
    while is_running:
        try:
            _, _, free_bytes = shutil.disk_usage(".")
            free_gb = free_bytes / (1024 ** 3)

            if free_gb < MIN_FREE_GB:
                files = glob.glob("front_*.mp4") + glob.glob("front_*.h264") + glob.glob("rear_*.avi")
                if files:
                    oldest_file = min(files, key=os.path.getmtime)
                    if time.time() - os.path.getmtime(oldest_file) > 30:
                        os.remove(oldest_file)
                        print(f"[自動削除] 容量確保のため削除: {oldest_file} (残: {free_gb:.2f}GB)")
        except Exception as e:
            print(f"自動削除処理エラー: {e}")

        time.sleep(10)

# GPS受信用スレッド
def read_gps():
    global latest_gps_info
    try:
        ser = serial.Serial('/dev/ttyACM0', 9600, timeout=1)
        while is_running:
            line = ser.readline().decode('ascii', errors='replace')
            if line.startswith('$GPRMC') or line.startswith('$GNRMC'):
                try:
                    msg = pynmea2.parse(line)
                    speed_kmh = float(msg.spd_over_grnd) * 1.852 if msg.spd_over_grnd else 0.0
                    lat = f"{msg.latitude:.6f} {msg.lat_dir}" if msg.latitude else "N/A"
                    lon = f"{msg.longitude:.6f} {msg.lon_dir}" if msg.longitude else "N/A"
                    gps_time = str(msg.timestamp) if msg.timestamp else "N/A"

                    with gps_lock:
                        latest_gps_info = {
                            "speed": f"{speed_kmh:.1f} km/h",
                            "lat": lat,
                            "lon": lon,
                            "time": gps_time
                        }
                    speed_label.config(text=f"{speed_kmh:.1f} km/h")
                except Exception:
                    pass
    except Exception:
        speed_label.config(text="GPS Err")

# --- フロントカメラ録画スレッド ---
def front_camera_thread():
    global is_running
    time.sleep(2.0)  # リアカメラとの競合を防ぐためのウェイト
    print("フロントカメラ: rpicam-vid (15FPS / 3分分割) 録画開始")

    while is_running:
        if is_recording:
            timestamp = time.strftime('%Y%m%d_%H%M%S')
            raw_filename = f"front_{timestamp}.h264"
            mp4_filename = f"front_{timestamp}.mp4"
            
            cmd = [
                "rpicam-vid",
                "-t", str(REC_INTERVAL_SEC * 1000),
                "--width", "1280",
                "--height", "720",
                "--framerate", str(int(FPS)),
                "--awb", "daylight",
                "--analoggain", "2.0",
                "--ev", "-1.0",
                "--metering", "centre",
                "-o", raw_filename,
                "--nopreview"
            ]

            try:
                proc = subprocess.Popen(cmd)
                
                for _ in range(REC_INTERVAL_SEC):
                    if not is_running:
                        proc.terminate()
                        proc.wait()
                        if os.path.exists(raw_filename):
                            subprocess.run(["ffmpeg", "-y", "-i", raw_filename, "-c", "copy", mp4_filename], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            os.remove(raw_filename)
                        return
                    time.sleep(1)

                proc.wait()

                if os.path.exists(raw_filename):
                    subprocess.run(["ffmpeg", "-y", "-i", raw_filename, "-c", "copy", mp4_filename], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    os.remove(raw_filename)

            except Exception as e:
                print(f"rpicam-vid エラー: {e}")
                time.sleep(2)
        else:
            time.sleep(1)

# --- リアカメラキャプチャ＆録画スレッド ---
def rear_camera_thread():
    global latest_rear_frame, is_running
    
    cap_usb = cv2.VideoCapture(1, cv2.CAP_V4L2)

    if not cap_usb.isOpened():
        print("リアカメラ(USB: /dev/video1)が開けませんでした")
        return

    cap_usb.set(cv2.CAP_PROP_FRAME_WIDTH, REAR_REC_WIDTH)
    cap_usb.set(cv2.CAP_PROP_FRAME_HEIGHT, REAR_REC_HEIGHT)
    cap_usb.set(cv2.CAP_PROP_FPS, FPS)

    actual_w = int(cap_usb.get(cv2.CAP_PROP_FRAME_WIDTH))
    actual_h = int(cap_usb.get(cv2.CAP_PROP_FRAME_HEIGHT))

    fourcc = cv2.VideoWriter_fourcc(*'XVID')
    out = None
    last_split_time = 0

    print("リアカメラ(USB) 起動成功 - キャプチャ開始")

    while is_running:
        start_time = time.time()
        ret, frame_bgr = cap_usb.read()
        if ret and frame_bgr is not None:
            frame_rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
            with frame_lock:
                latest_rear_frame = frame_rgb

            if is_recording:
                if start_time - last_split_time >= REC_INTERVAL_SEC or out is None:
                    last_split_time = start_time
                    if out is not None:
                        out.release()
                    filename = f"rear_{time.strftime('%Y%m%d_%H%M%S')}.avi"
                    out = cv2.VideoWriter(filename, fourcc, FPS, (actual_w, actual_h))

                if out is not None:
                    out.write(frame_bgr)

        elapsed = time.time() - start_time
        sleep_time = max(0, (1.0 / FPS) - elapsed)
        time.sleep(sleep_time)

    if out is not None:
        out.release()
    cap_usb.release()

# --- 画面描画更新 ---
def update_ui_frame():
    frame = None
    with frame_lock:
        if latest_rear_frame is not None:
            frame = latest_rear_frame.copy()

    if frame is not None:
        try:
            img = Image.fromarray(frame)
            img = img.resize((PREVIEW_WIDTH, PREVIEW_HEIGHT))
            imgtk = ImageTk.PhotoImage(image=img)
            video_label.imgtk = imgtk
            video_label.config(image=imgtk, text="")
        except Exception as e:
            print(f"UI描画エラー: {e}")

    if is_running:
        root.after(66, update_ui_frame)

# --- イベント保存処理 (LOCKボタン) ---
def save_event_data():
    timestamp = time.strftime('%Y%m%d_%H%M%S')
    event_dir = os.path.join(os.getcwd(), "events")
    os.makedirs(event_dir, exist_ok=True)

    with gps_lock:
        gps_data = latest_gps_info.copy()

    log_path = os.path.join(event_dir, f"event_{timestamp}.txt")
    with open(log_path, "w", encoding="utf-8") as f:
        f.write(f"--- DASHCAM EVENT LOG ({timestamp}) ---\n")
        f.write(f"Speed     : {gps_data['speed']}\n")
        f.write(f"Latitude  : {gps_data['lat']}\n")
        f.write(f"Longitude : {gps_data['lon']}\n")
        f.write(f"GPS Time  : {gps_data['time']}\n")

    all_videos = glob.glob("front_*.mp4") + glob.glob("front_*.h264") + glob.glob("rear_*.avi")
    copied_count = 0
    now = time.time()
    for vfile in all_videos:
        if now - os.path.getmtime(vfile) < 300:
            shutil.copy2(vfile, event_dir)
            copied_count += 1

    status_label.config(text=f"STATUS: [SAVED! ({copied_count} vids + GPS)]", fg="yellow")

def on_lock_click():
    status_label.config(text="STATUS: [SAVING EVENT...]", fg="red")
    threading.Thread(target=save_event_data, daemon=True).start()

# --- ボタン処理（終了＆シャットダウン） ---
def on_exit_click():
    global is_running
    is_running = False
    status_label.config(text="STATUS: [SHUTTING DOWN...]", fg="orange")
    root.update()
    time.sleep(1)
    root.destroy()
    subprocess.run(["sudo", "shutdown", "-h", "now"])

# UIメイン画面の設定（800x600解像度に最適化）
root = tk.Tk()
root.title("Dashcam UI")
root.geometry("800x600")
root.configure(bg="black")

# 最上部ヘッダー
top_frame = tk.Frame(root, bg="black")
top_frame.pack(fill="x", padx=10, pady=5)

speed_label = tk.Label(top_frame, text="--.- km/h", font=("Helvetica", 24, "bold"), fg="yellow", bg="black")
speed_label.pack(side="left", padx=10)

btn_exit = tk.Button(top_frame, text="✕ OFF", font=("Helvetica", 12, "bold"), bg="gray", fg="white", command=on_exit_click)
btn_exit.pack(side="right", ipadx=10, ipady=5)

# カメラ映像エリア（大きく拡大）
video_label = tk.Label(root, bg="black", fg="white", width=PREVIEW_WIDTH, height=PREVIEW_HEIGHT)
video_label.pack(pady=5)

# ステータス表示エリア
status_label = tk.Label(root, text="● DUAL REC (15FPS / 3min)", font=("Helvetica", 12), fg="cyan", bg="black")
status_label.pack(pady=2)

# 操作ボタンエリア
button_frame = tk.Frame(root, bg="black")
button_frame.pack(side="bottom", fill="x", pady=10, padx=15)

btn_lock = tk.Button(button_frame, text="REC / LOCK (SAVE EVENT)", font=("Helvetica", 14, "bold"), bg="red", fg="white", height=2, command=on_lock_click)
btn_lock.pack(fill="x", expand=True)

# スレッド開始
threading.Thread(target=auto_cleanup_thread, daemon=True).start()
threading.Thread(target=read_gps, daemon=True).start()
threading.Thread(target=front_camera_thread, daemon=True).start()
threading.Thread(target=rear_camera_thread, daemon=True).start()

root.after(100, update_ui_frame)

# タッチキャリブレーションの適用
apply_touch_calibration()

root.mainloop()
